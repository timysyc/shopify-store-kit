        },
        "b2": {
          "type": "benefit",
          "settings": {
            "icon": "leaf",
            "title": "Zero waste, zero refills",
            "text": "<p>No sticky sheets to buy or throw away. Empty the chamber and go again.</p>"
          }
        },
        "b3": {
          "type": "benefit",
          "settings": {
            "icon": "bolt",
            "title": "Fast enough for every day",
            "text": "<p>Keep it by the couch. A few passes before guests arrive and you're done.</p>"
          }
        },
        "b4": {
          "type": "benefit",
          "settings": {
            "icon": "heart",
            "title": "Gentle on your stuff",
            "text": "<p>No suction, heat or blades. Safe on sofas, duvets, cat trees and car seats.</p>"
          }
