    "faq": {
      "type": "ck-faq",
      "settings": {
        "heading": "Questions? <em>Answered.</em>",
        "contact_text": "Still unsure? Email <a href=\"mailto:hello@furlo.co\">hello@furlo.co</a> and a real person replies within 24 hours.",
        "scheme": "surface"
      },
      "blocks": {
        "q1": {
          "type": "question",
          "settings": {
            "question": "Does it work on cat hair and short dog hair?",
            "answer": "<p>Yes. The angled bristles grab long, short and fine fur. Short, stiff hair takes a few more passes in both directions.</p>"
          }
        },
        "q2": {
          "type": "question",
          "settings": {
            "question": "Will it damage my couch?",
            "answer": "<p>No. There is no suction, heat or blade. It's safe on fabric sofas, beds, rugs and car seats. Skip leather and silk.</p>"
          }
        },
        "q3": {
          "type": "question",
          "settings": {
            "question": "How do I clean it?",
            "answer": "<p>Open the lid and tip the fur into the bin. Rinse the bristle head under the tap when it needs a refresh and let it dry.</p>"
          }
        },
        "q4": {
          "type": "question",
          "settings": {
            "question": "How long does shipping take?",
            "answer": "<p>Orders leave our US warehouse in 1–2 business days and usually arrive in 5–9 business days. You get tracking by email.</p>"
          }
        },
        "q5": {
          "type": "question",
          "settings": {
            "question": "What if it doesn't work for me?",
            "answer": "<p>Email us within 60 days of delivery and we refund you in full. No forms, no hassle.</p>"
          }
        },
        "q6": {
          "type": "question",
          "settings": {
            "question": "Does it work on clothes?",
            "answer": "<p>It works on most fabrics, but it's built for furniture-sized areas. For clothes, lay them flat and use short strokes.</p>"
          }
        }
      },
