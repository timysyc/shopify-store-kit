{{ 'ck.css' | asset_url | stylesheet_tag }}
<script src="{{ 'ck.js' | asset_url }}" defer="defer"></script>
{%- assign us = section.settings.us_label | default: shop.name -%}
{%- capture yes -%}<span class="ck-yes" aria-label="Yes">{% render 'ck-icon', name: 'check' %}</span>{%- endcapture -%}
{%- capture no -%}<span class="ck-no" aria-label="No">{% render 'ck-icon', name: 'x' %}</span>{%- endcapture -%}
<section class="ck ck--{{ section.settings.scheme }} ck-comparison" style="--ck-pt: {{ section.settings.padding_top }}px; --ck-pb: {{ section.settings.padding_bottom }}px;">
  <div class="ck-container">
    {% render 'ck-head', s: section.settings %}
    {%- if section.settings.layout == 'cards' -%}
      <div class="ck-compare--cards ck-reveal">
        <div class="ck-compare-card ck-compare-card--us">
          <h3>{{ us }}</h3>
          <ul>
            {%- for block in section.blocks -%}
              <li {{ block.shopify_attributes }}>{{ yes }}<span>{% if block.settings.us_text != blank and block.settings.us_text != 'yes' %}{{ block.settings.us_text }}{% else %}{{ block.settings.feature }}{% endif %}</span></li>
            {%- endfor -%}
          </ul>
        </div>
        <div class="ck-compare-card">
          <h3>{{ section.settings.them_label }}</h3>
          <ul>
            {%- for block in section.blocks -%}
              <li>{{ no }}<span class="ck-muted">{% if block.settings.them_text != blank and block.settings.them_text != 'no' %}{{ block.settings.them_text }}{% else %}{{ block.settings.feature }}{% endif %}</span></li>
            {%- endfor -%}
          </ul>
        </div>
      </div>
    {%- else -%}
      <div class="ck-compare ck-reveal" role="table">
        <div class="ck-compare__row ck-compare__head" role="row">
          <div role="columnheader"></div>
          <div class="ck-compare__us" role="columnheader">{% if section.settings.us_logo != blank %}{{ section.settings.us_logo | image_url: height: 60 | image_tag: alt: us }}{% else %}{{ us }}{% endif %}</div>
          <div role="columnheader">{{ section.settings.them_label }}</div>
        </div>
        {%- for block in section.blocks -%}
          {%- assign u = block.settings.us_text | strip | downcase -%}
          {%- assign t = block.settings.them_text | strip | downcase -%}
          <div class="ck-compare__row" role="row" {{ block.shopify_attributes }}>
            <div role="cell">{{ block.settings.feature }}</div>
            <div class="ck-compare__us" role="cell">{% if u == 'yes' or u == '' %}{{ yes }}{% elsif u == 'no' %}{{ no }}{% else %}{{ block.settings.us_text }}{% endif %}</div>
            <div role="cell">{% if t == 'no' or t == '' %}{{ no }}{% elsif t == 'yes' %}{{ yes }}{% else %}{{ block.settings.them_text }}{% endif %}</div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <div class="ck-center"><a class="ck-btn" href="{{ section.settings.button_link | default: '#' }}">{{ section.settings.button_label }}</a></div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "CK Comparison",
  "settings": [
    { "type": "select", "id": "layout", "label": "Layout", "default": "table", "options": [
      { "value": "table", "label": "Table" }, { "value": "cards", "label": "Two cards (us vs them)" }
    ] },
    { "type": "text", "id": "eyebrow", "label": "Small label" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Us vs. <em>them</em>" },
    { "type": "text", "id": "subheading", "label": "Subheading" },
    { "type": "text", "id": "us_label", "label": "Your column name", "info": "Leave empty to use your store name." },
    { "type": "image_picker", "id": "us_logo", "label": "Your logo (optional)" },
    { "type": "text", "id": "them_label", "label": "Competitor column name", "default": "Others" },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "header", "content": "Section style" },
    { "type": "select", "id": "scheme", "label": "Background", "default": "default", "options": [
      { "value": "default", "label": "Page background" }, { "value": "surface", "label": "Alternate" }, { "value": "accent", "label": "Soft accent" }, { "value": "primary", "label": "Brand colour" }, { "value": "dark", "label": "Dark" }
    ] },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 140, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 140, "step": 4, "unit": "px", "default": 72 }
  ],
  "blocks": [
    {
      "type": "row", "name": "Row",
      "settings": [
        { "type": "text", "id": "feature", "label": "Feature", "default": "Feature" },
        { "type": "text", "id": "us_text", "label": "Yours (yes / no / custom text)", "default": "yes" },
        { "type": "text", "id": "them_text", "label": "Theirs (yes / no / custom text)", "default": "no" }
      ]
    }
  ],
  "presets": [ { "name": "CK Comparison", "blocks": [ { "type": "row" }, { "type": "row" }, { "type": "row" } ] } ]
}
{% endschema %}
