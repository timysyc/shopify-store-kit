{%- comment -%} CK Feature Hotspots — product image with numbered pins + a legend ("anatomy" / "what's inside"). {%- endcomment -%}
{{ 'ck.css' | asset_url | stylesheet_tag }}
<script src="{{ 'ck.js' | asset_url }}" defer="defer"></script>
<section class="ck ck--{{ section.settings.scheme }} ck-hs-sec" style="--ck-pt: {{ section.settings.padding_top }}px; --ck-pb: {{ section.settings.padding_bottom }}px;">
  <div class="ck-container">
    {% render 'ck-head', s: section.settings %}
    <div class="ck-hs" data-ck-hotspots>
      <div class="ck-hs__media ck-reveal">
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 55vw, 100vw', widths: '600, 900, 1200, 1400' }}
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'ck-placeholder' }}
        {%- endif -%}
        {%- for block in section.blocks -%}
          <button type="button" class="ck-hs__pin" style="left: {{ block.settings.x }}%; top: {{ block.settings.y }}%;" data-ck-pin="{{ forloop.index0 }}" aria-label="{{ block.settings.title | escape }}">{{ forloop.index }}</button>
        {%- endfor -%}
      </div>
      <ol class="ck-hs__list">
        {%- for block in section.blocks -%}
          <li class="ck-hs__item ck-reveal{% if forloop.first %} is-active{% endif %}" data-ck-pin-item="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
            <span class="ck-hs__n">{{ forloop.index }}</span>
            <div><h3 class="ck-h ck-h3">{{ block.settings.title }}</h3><p>{{ block.settings.text }}</p></div>
          </li>
        {%- endfor -%}
      </ol>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "CK Feature Hotspots",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image", "info": "A clean product shot. Place pins with the X/Y sliders on each block." },
    { "type": "text", "id": "eyebrow", "label": "Small label" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Designed down to <em>the detail</em>" },
    { "type": "text", "id": "subheading", "label": "Subheading" },
    { "type": "header", "content": "Section style" },
    { "type": "select", "id": "scheme", "label": "Background", "default": "surface", "options": [
      { "value": "default", "label": "Page background" }, { "value": "surface", "label": "Alternate" }, { "value": "accent", "label": "Soft accent" }, { "value": "primary", "label": "Brand colour" }, { "value": "dark", "label": "Dark" }
    ] },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 140, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 140, "step": 4, "unit": "px", "default": 72 }
  ],
  "blocks": [
    {
      "type": "spot", "name": "Hotspot", "limit": 6,
      "settings": [
        { "type": "range", "id": "x", "label": "Left → right position", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 50 },
        { "type": "range", "id": "y", "label": "Top → bottom position", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 50 },
        { "type": "text", "id": "title", "label": "Title", "default": "Feature" },
        { "type": "text", "id": "text", "label": "Text", "default": "What it does for the customer." }
      ]
    }
  ],
  "presets": [ { "name": "CK Feature Hotspots", "blocks": [ { "type": "spot", "settings": { "x": 30, "y": 30 } }, { "type": "spot", "settings": { "x": 65, "y": 45 } }, { "type": "spot", "settings": { "x": 45, "y": 75 } } ] } ]
}
{% endschema %}
