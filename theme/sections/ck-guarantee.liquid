{{ 'ck.css' | asset_url | stylesheet_tag }}
<script src="{{ 'ck.js' | asset_url }}" defer="defer"></script>
{%- assign trust = section.settings.trust | split: ',' -%}
<section class="ck ck--{{ section.settings.scheme }} ck-guarantee" style="--ck-pt: {{ section.settings.padding_top }}px; --ck-pb: {{ section.settings.padding_bottom }}px;">
  <div class="ck-container">
    <div class="ck-guar ck-reveal">
      <div class="ck-seal">
        <div class="ck-seal__days">{{ section.settings.days }}</div>
        <div class="ck-seal__text">{{ section.settings.seal_text }}</div>
      </div>
      <div>
        <h2 class="ck-h ck-h2">{{ section.settings.heading }}</h2>
        <div>{{ section.settings.text }}</div>
        {%- if section.settings.trust != blank -%}
          <div class="ck-guar__trust">
            {%- for t_raw in trust -%}{%- assign t = t_raw | strip -%}{%- if t != blank -%}<span>{% render 'ck-icon', name: 'check' %}{{ t }}</span>{%- endif -%}{%- endfor -%}
          </div>
        {%- endif -%}
        {%- if section.settings.button_label != blank -%}
          <a class="ck-btn" href="{{ section.settings.button_link | default: '#' }}">{{ section.settings.button_label }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "CK Guarantee",
  "settings": [
    { "type": "text", "id": "days", "label": "Big number", "default": "30" },
    { "type": "text", "id": "seal_text", "label": "Seal text", "default": "Day money-back guarantee" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Try it <em>risk-free</em>" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>If you are not happy, email us within 30 days for a full refund. No forms, no hassle.</p>" },
    { "type": "text", "id": "trust", "label": "Trust points (comma separated)", "default": "Free returns, Fast support, Secure checkout" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Claim my discount" },
    { "type": "url", "id": "button_link", "label": "Button link", "info": "Tip: link to #top or your product page." },
    { "type": "header", "content": "Section style" },
    { "type": "select", "id": "scheme", "label": "Background", "default": "surface", "options": [
      { "value": "default", "label": "Page background" }, { "value": "surface", "label": "Alternate" }, { "value": "accent", "label": "Soft accent" }, { "value": "primary", "label": "Brand colour" }, { "value": "dark", "label": "Dark" }
    ] },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 140, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 140, "step": 4, "unit": "px", "default": 72 }
  ],
  "presets": [ { "name": "CK Guarantee" } ]
}
{% endschema %}
